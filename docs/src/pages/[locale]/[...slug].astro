---
import { getCollection, render } from "astro:content";
import { config } from "virtual:nimbus/config";
import { getSidebar, getPrevNext, getBreadcrumbs, getLastUpdated, getTOC } from "nimbus-docs";
import type { Breadcrumb, PrevNext, SidebarItem } from "nimbus-docs/types";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { components } from "../../components";
import { docsNavigationMessage, getTranslator, localePrefix, localizedPath, type Locale } from "@/i18n";

export const prerender = true;

export async function getStaticPaths() {
  const localeCollections = [
    { locale: "es", collection: "_docsEs" },
    { locale: "fr", collection: "_docsFr" },
    { locale: "de", collection: "_docsDe" },
    { locale: "ja", collection: "_docsJa" },
    { locale: "ko", collection: "_docsKo" },
    { locale: "pt-BR", collection: "_docsPtBr" },
    { locale: "vi", collection: "_docsVi" },
  ] as const;
  const localizedPaths = await Promise.all(localeCollections.map(async ({ locale, collection }) => {
    const entries = await getCollection(collection);
    return entries.map((entry) => ({
      params: {
        locale: localePrefix(locale).replace(/^\//, ""),
        slug: entry.id.replace(/\/index$/, ""),
      },
      props: { entry, locale },
    }));
  }));
  return localizedPaths.flat();
}

const locale = Astro.props.locale as Locale;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const localeEntries = await getCollection(entry.collection);
const localizedTitles = new Map(
  localeEntries.map((localizedEntry) => [
    localizedEntry.id.replace(/\/index$/, ""),
    localizedEntry.data.title,
  ]),
);
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const prefix = localePrefix(locale);
const sourceSlug = currentSlug.slice(prefix.length) || "/";
const t = await getTranslator(locale);

function localizedTitleForHref(href?: string) {
  if (!href) return undefined;
  const sourcePath = href
    .replace(new RegExp(`^${prefix}(?=/|$)`), "")
    .replace(/^\/+|\/+$/g, "")
    .replace(/\/index$/, "");
  return localizedTitles.get(sourcePath);
}

function localizeSidebar(items: SidebarItem[]): SidebarItem[] {
  return items.map((item) => {
    const message = docsNavigationMessage(item.label);
    const label = message
      ? t(message)
      : localizedTitleForHref(item.type === "group" ? item.indexHref : item.href) ?? item.label;
    if (item.type === "external") return item;
    if (item.type === "group") {
      return {
        ...item,
        label,
        indexHref: item.indexHref ? localizedPath(locale, item.indexHref) : undefined,
        children: localizeSidebar(item.children),
      };
    }
    return { ...item, label, href: localizedPath(locale, item.href) };
  });
}

const rawSidebar = await getSidebar(sourceSlug, { collection: entry.collection });
const sidebar = localizeSidebar(rawSidebar);
const rawPrevNext = await getPrevNext(sourceSlug, {
  sidebarTree: rawSidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const prevNext: PrevNext = {
  prev: rawPrevNext.prev && {
    ...rawPrevNext.prev,
    label: localizedTitleForHref(rawPrevNext.prev.href) ?? rawPrevNext.prev.label,
    href: localizedPath(locale, rawPrevNext.prev.href),
  },
  next: rawPrevNext.next && {
    ...rawPrevNext.next,
    label: localizedTitleForHref(rawPrevNext.next.href) ?? rawPrevNext.next.label,
    href: localizedPath(locale, rawPrevNext.next.href),
  },
};
const rawBreadcrumbs = await getBreadcrumbs(sourceSlug, { collection: entry.collection });
const breadcrumbs: Breadcrumb[] = rawBreadcrumbs.map((crumb) => ({
  ...crumb,
  label: docsNavigationMessage(crumb.label)
    ? t(docsNavigationMessage(crumb.label)!)
    : localizedTitleForHref(crumb.href) ?? (crumb.href ? crumb.label : entry.data.title),
  href: crumb.href ? localizedPath(locale, crumb.href) : undefined,
}));
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath = `${prefix}/${entry.id}/index.md`;
const markdownUrl = Astro.site ? new URL(markdownPath, Astro.site).href : markdownPath;
const socialImage = entry.data.socialImage ?? `/og/${entry.id}.png`;
const pagefindLanguage = locale === "pt-BR" ? "pt" : locale.toLowerCase();
const socialTitle = locale === "en"
  ? undefined
  : entry.data.title === config.title || entry.data.title.startsWith(`${config.title} `)
    ? entry.data.title
    : `${entry.data.title} | ${config.title}`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={true}
  noindex={false}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={undefined}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
  pagefindLanguage={pagefindLanguage}
  socialTitle={socialTitle}
>
  <Content components={components} />
</DocsLayout>
