---
import { getDocsPageProps, getDocsStaticPaths, getSidebar, getPrevNext, getBreadcrumbs, getEditUrl, getLastUpdated, getTOC } from "nimbus-docs";
import type { Breadcrumb, PrevNext, SidebarItem } from "nimbus-docs/types";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { components } from "../../components";
import { getTranslator, localePrefix, localizedPath, type Locale } from "@/i18n";

export const prerender = true;

export async function getStaticPaths(context: Parameters<typeof getDocsStaticPaths>[0]) {
  const fallbackLocales: Locale[] = ["es", "fr", "de", "ja", "ko", "pt-BR", "vi"];
  const paths = await getDocsStaticPaths(context);
  return fallbackLocales.flatMap((locale) => paths.map(({ params, props }) => ({
    params: {
      locale: localePrefix(locale).replace(/^\//, ""),
      slug: params.slug?.replace(/\/index$/, "") ?? "docs",
    },
    props: { ...props, locale },
  })));
}

const locale = Astro.props.locale as Locale;
const { entry, Content, headings } = await getDocsPageProps(Astro);
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const prefix = localePrefix(locale);
const sourceSlug = currentSlug.slice(prefix.length) || "/";

function localizeSidebar(items: SidebarItem[]): SidebarItem[] {
  return items.map((item) => {
    if (item.type === "external") return item;
    if (item.type === "group") {
      return {
        ...item,
        indexHref: item.indexHref ? localizedPath(locale, item.indexHref) : undefined,
        children: localizeSidebar(item.children),
      };
    }
    return { ...item, href: localizedPath(locale, item.href) };
  });
}

const rawSidebar = await getSidebar(sourceSlug, { collection: entry.collection });
const sidebar = localizeSidebar(rawSidebar);
const rawPrevNext = await getPrevNext(sourceSlug, {
  sidebarTree: rawSidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const prevNext: PrevNext = {
  prev: rawPrevNext.prev && { ...rawPrevNext.prev, href: localizedPath(locale, rawPrevNext.prev.href) },
  next: rawPrevNext.next && { ...rawPrevNext.next, href: localizedPath(locale, rawPrevNext.next.href) },
};
const rawBreadcrumbs = await getBreadcrumbs(sourceSlug, { collection: entry.collection });
const breadcrumbs: Breadcrumb[] = rawBreadcrumbs.map((crumb) => ({
  ...crumb,
  href: crumb.href ? localizedPath(locale, crumb.href) : undefined,
}));
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath = `/${entry.id}/index.md`;
const markdownUrl = Astro.site ? new URL(markdownPath, Astro.site).href : markdownPath;
const socialImage = entry.data.socialImage ?? `/og/${entry.id}.png`;
const t = await getTranslator(locale);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={false}
  noindex={true}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
  pagefindLanguage="en"
>
  <p class="mb-5 rounded-md border border-border bg-muted px-3 py-2 text-sm text-muted-foreground" role="note">
    {t("docs.englishContent")}
  </p>
  <div lang="en">
    <Content components={components} />
  </div>
</DocsLayout>
