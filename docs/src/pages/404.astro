---
import BaseLayout from "../layouts/BaseLayout.astro";

// Cloudflare Pages serves dist/404.html with a 404 status. Without it, every
// unknown path fell back to the homepage with a 200, which search engines read
// as a site full of duplicate pages (soft 404s).
export const prerender = true;
---

<BaseLayout title="Page not found | AnyPick" description="This page does not exist." noindex>
  <main id="main-content" class="mx-auto flex min-h-screen max-w-xl flex-col items-start justify-center gap-4 px-4">
    <p class="text-sm font-medium text-muted-foreground">404</p>
    <h1 class="text-3xl font-semibold">Page not found</h1>
    <p class="text-muted-foreground">The page you asked for does not exist or has moved.</p>
    <div class="flex gap-4">
      <a class="text-primary underline" href="/">AnyPick home</a>
      <a class="text-primary underline" href="/docs/">Documentation</a>
    </div>
  </main>
</BaseLayout>
