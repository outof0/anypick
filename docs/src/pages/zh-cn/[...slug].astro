---
import { getCollection, render } from "astro:content";
import type { SidebarItem } from "nimbus-docs/types";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { components } from "../../components";
import { getTOC } from "nimbus-docs";

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection("docsZh");
  return entries.map((entry) => ({
    params: {
      slug: entry.id.replace(/^zh-cn\//, "").replace(/\/index$/, ""),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/zh-cn/docs";
const docsRoot = "/zh-cn/docs";
const links = [
  ["开始使用", `${docsRoot}/getting-started`],
  ["应用与终端界面", `${docsRoot}/guides/terminal-ui`],
  ["macOS 应用与菜单栏", `${docsRoot}/guides/tray`],
  ["核心概念", `${docsRoot}/concepts`],
  ["账户", `${docsRoot}/guides/accounts`],
  ["网关", `${docsRoot}/guides/gateways`],
  ["代理", `${docsRoot}/guides/proxies`],
  ["项目绑定", `${docsRoot}/guides/projects`],
  ["插件", `${docsRoot}/guides/plugins`],
  ["CLI 参考", `${docsRoot}/reference/cli`],
  ["故障排查", `${docsRoot}/reference/troubleshooting`],
] as const;
const makeLink = (label: string, href: string, order: number): SidebarItem => ({
  type: "link",
  label,
  href,
  order,
  isCurrent: pathname === href || (href === docsRoot && pathname === docsRoot),
});
const sidebar: SidebarItem[] = [
  makeLink("AnyPick 文档", docsRoot, 0),
  makeLink(links[0][0], links[0][1], 1),
  makeLink(links[1][0], links[1][1], 2),
  makeLink(links[2][0], links[2][1], 3),
  makeLink(links[3][0], links[3][1], 4),
  {
    type: "group",
    label: "指南",
    order: 5,
    children: links.slice(4, 9).map(([label, href], index) => makeLink(label, href, index)),
  },
  {
    type: "group",
    label: "参考",
    order: 6,
    children: links.slice(9).map(([label, href], index) => makeLink(label, href, index)),
  },
];
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={getTOC(headings)}
  breadcrumbs={[
    { label: "文档", href: docsRoot },
    ...(pathname === docsRoot ? [] : [{ label: entry.data.title }]),
  ]}
  prevNext={{}}
  searchable={true}
  socialImage="/og-image.png"
>
  <Content components={components} />
</DocsLayout>
