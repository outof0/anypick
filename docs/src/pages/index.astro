---
import { Icon } from "astro-icon/components";
import { config } from "virtual:nimbus/config";
import AppShot from "../components/AppShot.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const githubUrl = config.github ?? "https://github.com/outof0/anypick";
const releasesUrl = `${githubUrl}/releases/latest`;
const changelogUrl = `${githubUrl}/blob/main/CHANGELOG.md`;
const securityUrl = `${githubUrl}/blob/main/SECURITY.md`;
const licenseUrl = `${githubUrl}/blob/main/LICENSE`;
const gettingStartedUrl = "/docs/getting-started/";
const npmCommand = "npm install -g anypick";
const socialTitle = "AnyPick: switch AI coding agents between accounts & API keys";
const metaDescription =
  "Pick which login or API key Claude Code, Codex, Gemini CLI and 8 more use: globally, per project, or per terminal. Open source. One command to undo.";

const scopes = [
  {
    label: "Everywhere",
    command: "anypick use claude --with claude/work",
    body: "Sets the default for that app.",
  },
  {
    label: "This project",
    command: "anypick link claude --with claude/personal",
    body: "Applies only inside this directory.",
    href: "/docs/guides/projects",
  },
  {
    label: "This terminal only",
    command: "anypick run claude --with openrouter-work",
    body: "Launches one isolated session. Your global config isn't touched.",
  },
];

const agents = ["Claude Code", "OpenAI Codex", "Gemini CLI", "OpenCode", "Kiro", "Pi", "Omp", "Command Code", "DeepSeek Harness", "WorkBuddy AI", "ZCode"];
const logins = ["Claude Code", "OpenAI Codex", "Google Gemini", "xAI Grok", "Kiro", "Cline", "OpenCode", "WorkBuddy", "Z.ai (GLM)"];
const apiKeys = ["OpenRouter", "DeepSeek", "Moonshot Kimi", "Qwen", "MiniMax", "Mistral", "Groq", "Cerebras", "Fireworks", "Together", "NVIDIA NIM", "SiliconFlow", "Cloudflare AI Gateway", "Volcengine Ark", "Xiaomi MiMo"];

const safety = [
  {
    icon: "ph:shield-check",
    title: "Only touches what it owns.",
    body: "AnyPick marks the exact keys it writes (_anypickManaged in Claude's settings, a fenced # BEGIN anypick-managed block in Codex's config.toml). Your theme, MCP servers and other settings stay put.",
  },
  {
    icon: "ph:hand",
    title: "Asks before taking over.",
    body: "If a file already has settings AnyPick didn't write, it stops: “Nothing was changed; confirm the takeover.” When you confirm, it backs up the original first.",
  },
  {
    icon: "ph:arrow-counter-clockwise",
    title: "One command to undo.",
    body: "anypick reset claude restores the settings you had before.",
  },
];

const trust = [
  { icon: "ph:code", title: "Open source, MIT.", body: "Read every line on GitHub." },
  { icon: "ph:path", title: "No middleman.", body: "AnyPick never relays your traffic through anyone's servers. Requests go straight to the provider you chose, through a local translator when needed." },
  { icon: "ph:handshake", title: "Plays by provider rules.", body: "Claude logins only ever power Claude Code. AnyPick reuses logins created by each provider's own sign-in. It never asks for your password." },
  { icon: "ph:lock-key", title: "Secrets stay behind one boundary.", body: "Credentials and proxy tokens live in the Go core, never in the UI." },
  { icon: "ph:seal-check", title: "Verifiable builds.", body: "Release checksums, an SPDX SBOM, and npm provenance attestations." },
  { icon: "ph:cube", title: "One native binary.", body: "No background daemon you didn't ask for, and the CLI needs no Node runtime (npm is just a launcher)." },
];

const byHand = [
  { task: "Switch Claude Code to another account", manual: "Log out, clear the keychain, re-login", anypick: "anypick use claude --with claude/personal" },
  { task: "Try a provider without losing your setup", manual: "Export env vars and hope ANTHROPIC_API_KEY=\"\" is right", anypick: "anypick run claude --with openrouter-work" },
  { task: "Different account per repo", manual: "CLAUDE_CONFIG_DIR aliases that leak", anypick: "anypick link …" },
  { task: "Codex on a non-OpenAI provider", manual: "Hand-write model_providers TOML", anypick: "anypick use codex --with <gateway>" },
  { task: "Undo", manual: "Remember what you changed", anypick: "anypick reset <app>" },
];

const faq = [
  { q: "Is it free?", a: "Yes. AnyPick is MIT-licensed." },
  { q: "Does AnyPick see or relay my prompts?", a: "No. AnyPick has no servers. When a translator is needed, it runs on 127.0.0.1 on your machine." },
  { q: "Where are my credentials stored?", a: "Locally in ~/.anypick. Remove everything with npm uninstall -g anypick and by deleting ~/.anypick." },
  { q: "Is this allowed by the providers?", a: "AnyPick reuses logins created by each provider's own sign-in and keeps Claude logins inside Claude Code. API keys are used under your own agreement with each provider. Check your provider's terms for subscription use in third-party tools." },
  { q: "What happens to my existing config?", a: "AnyPick won't overwrite settings it didn't write without asking, backs them up when you confirm, and anypick reset restores them." },
  { q: "Which apps and providers work together?", a: "See the CLI reference and guides. AnyPick only offers the pairings that work." },
  { id: "faq-macos", q: "Why does macOS warn me?", a: "The app isn't notarized yet. Right-click AnyPick.app → Open, or go to System Settings → Privacy & Security → Open Anyway. The CLI via Homebrew is unaffected." },
  { q: "I used anypick 1.0.0 from npm. What changed?", a: "1.1.0 replaced the JavaScript CLI with the native one, which doesn't run third-party plugins. Pin anypick@1.0.0 if you need the old one." },
];

---

<BaseLayout
  title={socialTitle}
  socialTitle={socialTitle}
  description={metaDescription}
  socialImage="/og-landing.png"
  socialImageAlt="AnyPick: Pick which account every AI coding agent uses. Shown next to the AnyPick desktop app's Overview page in dark mode."
>
  <div class="landing min-h-screen bg-[#080A11] text-[#F8FAFC]">
    <Header showSidebar={false} appearance="landing" />

    <main id="main-content">
      <section class="hero relative isolate overflow-hidden">
        <div class="hero-grid pointer-events-none absolute inset-0 -z-20" aria-hidden="true"></div>
        <div class="hero-light pointer-events-none absolute -z-10" aria-hidden="true"></div>

        <div class="mx-auto w-full max-w-7xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20 lg:pt-24 lg:pb-24">
          <div class="hero-copy mx-auto max-w-4xl text-center">
            <p class="eyebrow">
              <span></span>
              Pick any. Code on.
            </p>
            <h1 class="mt-5 text-balance text-[clamp(2.4rem,6.4vw,4.6rem)] font-semibold leading-[1.02] tracking-[-0.05em]">
              Pick which account <span>every AI coding agent uses.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-3xl text-pretty text-lg leading-8 text-[#98A2B3] sm:text-xl">
              Point Claude Code, Codex, Gemini CLI and 8 more at any login or API key you have: globally, per project, or for one terminal. AnyPick writes the config, translates protocols when needed, and puts everything back with one command.
            </p>
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <a class="primary-cta" href={releasesUrl}>
                Download the desktop app
                <Icon name="ph:arrow-up-right" class="h-4 w-4" />
              </a>
              <a class="secondary-cta" href="#install">
                Install the CLI
                <Icon name="ph:arrow-down" class="h-4 w-4" />
              </a>
            </div>
            <p class="install-meta mt-4">Free and open source (MIT) · macOS · Linux · Windows · One native binary, checksummed</p>
            <p class="install-meta mt-1">macOS: first launch? See <a class="text-link" href="#faq-macos">how to open an unsigned app</a>.</p>
          </div>

          <figure class="app-frame hero-shot mx-auto mt-12 max-w-5xl">
            <AppShot
              name="overview"
              width={1040}
              height={760}
              sizes="(min-width: 1088px) 1024px, calc(100vw - 2.5rem)"
              priority
              alt="AnyPick desktop app for macOS, dark mode, on the Overview page. Installation Health has a Run Doctor button. Active Apps lists Claude Code and OpenAI Codex using the Work account and OpenCode using demo-team, each through an AnyPick proxy. Services shows 3 of 3 proxies running, and Recent Activity logs each app's latest account switch."
            />
          </figure>
        </div>
      </section>

      <section class="section-shell border-y border-white/8 bg-[#0B0D15]">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="feature-row">
            <div class="section-heading">
              <p class="section-kicker">Accounts &amp; APIs</p>
              <h2>Every login and API key, in one list.</h2>
              <p>Claude, Codex, Gemini, Kiro, Cline and OpenRouter accounts sit side by side with your API gateways. A check mark shows which one each app is using right now.</p>
            </div>
            <figure class="app-frame">
              <AppShot
                name="accounts"
                width={1040}
                height={760}
                sizes="(min-width: 1024px) 50vw, calc(100vw - 2.5rem)"
                alt="The Accounts & APIs page in AnyPick's dark-mode desktop app. It lists nine saved accounts: three Claude (Personal, Team, Work), two Codex (Client, Work), one each for Gemini, Kiro and Cline, and an OpenRouter key named demo-team. The Claude and Codex Work accounts have green check marks. Below is one API gateway, Staging Gateway, with Add Login and Add API Gateway buttons. All emails are example.com demo data."
              />
            </figure>
          </div>
        </div>
      </section>

      <section class="section-shell">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="feature-row feature-row-reverse">
            <div class="section-heading">
              <p class="section-kicker">Menu bar</p>
              <h2>Switch without leaving your editor.</h2>
              <p>Open the menu bar panel, see how much usage each account has left, and pick a different one for Claude Code or Codex in one click.</p>
            </div>
            <figure class="app-frame app-frame-tray">
              <AppShot
                name="tray"
                width={336}
                height={430}
                sizes="336px"
                alt="AnyPick's macOS menu bar panel in dark mode. A search field reads 'Search 9 saved accounts'. Claude Code is using Work with 68% usage left, and OpenAI Codex is using Work with 81% left. Each has chips for switching accounts and a Switch link. Below are Other Apps (Gemini, Kiro), a proxies row showing 3 running, and Quit and Open AnyPick buttons."
              />
            </figure>
          </div>
        </div>
      </section>

      <section class="section-shell border-y border-white/8 bg-[#0B0D15]">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="feature-row">
            <div class="section-heading">
              <p class="section-kicker">Settings</p>
              <h2>Runs quietly. Steps aside at the limit.</h2>
              <p>Open at login, start your proxies when the app launches, show remaining usage, and skip accounts that have hit their usage limit.</p>
              <a class="secondary-cta mt-6" href={releasesUrl}>Download for macOS · Windows · Linux <Icon name="ph:arrow-up-right" class="h-4 w-4" /></a>
              <p class="note mt-3">Screenshots show the macOS app with demo data. The Windows and Linux apps use the same engine and accounts.</p>
            </div>
            <figure class="app-frame">
              <AppShot
                name="settings"
                width={1040}
                height={760}
                sizes="(min-width: 1024px) 50vw, calc(100vw - 2.5rem)"
                alt="The Settings page in AnyPick's dark-mode desktop app. Under Startup, Open at Login and Start Enabled Proxies at Launch are on. Under Getting Started, a Show button brings back the setup checklist. Under Usage, Show Usage Remaining and Skip Accounts That Reach Their Usage Limit are on."
              />
            </figure>
          </div>
        </div>
      </section>

      <section class="section-shell" id="cli">
        <div class="mx-auto max-w-5xl px-5 sm:px-8">
          <div class="section-heading mx-auto max-w-3xl text-center">
            <p class="section-kicker">Prefer the terminal?</p>
            <h2>The same picker, as a CLI.</h2>
            <p>Everything in this recording is real output from <code>anypick</code> 1.1.0, run in a sandbox with demo accounts.</p>
          </div>
          <div class="mt-10">
              <figure class="demo-frame">
                <div class="demo-titlebar" aria-hidden="true">
                  <span></span><span></span><span></span>
                  <p>anypick 1.1.0 · real CLI output, sandboxed demo accounts</p>
                </div>
                <video
                  class="demo-video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  width="1280"
                  height="720"
                  poster="/demo/anypick-hero-poster.png"
                  aria-label="Terminal demo: list saved accounts, add an OpenRouter gateway, point Claude Code at it, then reset back to the original settings."
                  data-demo-video
                >
                  <source src="/demo/anypick-hero.webm" type="video/webm" />
                  <source src="/demo/anypick-hero.mp4" type="video/mp4" />
                  <img src="/demo/anypick-hero.gif" alt="AnyPick terminal demo" width="1280" height="720" />
                </video>
                <figcaption>Save the logins you have, bring any API key, pick one, undo with one command.</figcaption>
              </figure>

              <div id="install" class="install-card mt-8 scroll-mt-24" data-install-tabs>
                <p class="install-label">Install the CLI</p>
                <div class="install-tabs mt-3" role="tablist" aria-label="Choose an install method">
                  <button id="install-tab-macos" class="install-tab" type="button" role="tab" aria-selected="true" aria-controls="install-panel-macos" data-install-tab="macos">macOS</button>
                  <button id="install-tab-linux" class="install-tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-linux" tabindex="-1" data-install-tab="linux">Linux</button>
                  <button id="install-tab-windows" class="install-tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-windows" tabindex="-1" data-install-tab="windows">Windows</button>
                  <button id="install-tab-npm" class="install-tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-npm" tabindex="-1" data-install-tab="npm">Any OS</button>
                </div>

                <div class="install-panel" id="install-panel-macos" role="tabpanel" aria-labelledby="install-tab-macos" data-install-panel="macos">
                  <div class="install-shell">
                    <span class="prompt" aria-hidden="true">$</span>
                    <code>brew install outof0/tap/anypick</code>
                    <button type="button" data-copy="brew install outof0/tap/anypick" aria-label="Copy Homebrew install command">
                      <Icon name="ph:copy" class="copy-icon h-4 w-4" />
                      <Icon name="ph:check" class="check-icon hidden h-4 w-4" />
                      <span>Copy</span>
                    </button>
                  </div>
                  <p class="install-hint">Desktop app: <code>brew install --cask outof0/tap/anypick</code> or the <a class="text-link" href={releasesUrl}>.dmg on GitHub Releases</a>.</p>
                </div>

                <div class="install-panel" id="install-panel-linux" role="tabpanel" aria-labelledby="install-tab-linux" data-install-panel="linux" hidden>
                  <div class="install-shell">
                    <span class="prompt" aria-hidden="true">$</span>
                    <code>{npmCommand}</code>
                    <button type="button" data-copy={npmCommand} aria-label="Copy npm install command">
                      <Icon name="ph:copy" class="copy-icon h-4 w-4" />
                      <Icon name="ph:check" class="check-icon hidden h-4 w-4" />
                      <span>Copy</span>
                    </button>
                  </div>
                  <p class="install-hint">Or grab a package from <a class="text-link" href={releasesUrl}>GitHub Releases</a>: .deb · .rpm · AppImage · tarball.</p>
                </div>

                <div class="install-panel" id="install-panel-windows" role="tabpanel" aria-labelledby="install-tab-windows" data-install-panel="windows" hidden>
                  <div class="install-shell">
                    <span class="prompt" aria-hidden="true">&gt;</span>
                    <code>scoop bucket add outof0 https://github.com/outof0/scoop-bucket</code>
                    <button type="button" data-copy="scoop bucket add outof0 https://github.com/outof0/scoop-bucket" aria-label="Copy Scoop bucket command">
                      <Icon name="ph:copy" class="copy-icon h-4 w-4" />
                      <Icon name="ph:check" class="check-icon hidden h-4 w-4" />
                      <span>Copy</span>
                    </button>
                  </div>
                  <div class="install-shell mt-2">
                    <span class="prompt" aria-hidden="true">&gt;</span>
                    <code>scoop install anypick</code>
                    <button type="button" data-copy="scoop install anypick" aria-label="Copy Scoop install command">
                      <Icon name="ph:copy" class="copy-icon h-4 w-4" />
                      <Icon name="ph:check" class="check-icon hidden h-4 w-4" />
                      <span>Copy</span>
                    </button>
                  </div>
                  <p class="install-hint">Desktop app: .msi · .exe installer on <a class="text-link" href={releasesUrl}>GitHub Releases</a>.</p>
                </div>

                <div class="install-panel" id="install-panel-npm" role="tabpanel" aria-labelledby="install-tab-npm" data-install-panel="npm" hidden>
                  <div class="install-shell">
                    <span class="prompt" aria-hidden="true">$</span>
                    <code>{npmCommand}</code>
                    <button type="button" data-copy={npmCommand} aria-label="Copy npm install command">
                      <Icon name="ph:copy" class="copy-icon h-4 w-4" />
                      <Icon name="ph:check" class="check-icon hidden h-4 w-4" />
                      <span>Copy</span>
                    </button>
                  </div>
                  <p class="install-hint">Node 18+. Downloads the matching native CLI on first run.</p>
                </div>

                <a class="desktop-release-link" href={gettingStartedUrl}>
                  Read the 5-minute guide
                  <Icon name="ph:arrow-right" class="h-4 w-4" aria-hidden="true" />
                </a>
                <p class="sr-only" aria-live="polite" data-copy-status></p>
              </div>
          </div>
        </div>
      </section>

      <section class="section-shell border-y border-white/8 bg-[#0B0D15]">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="section-heading max-w-3xl">
            <p class="section-kicker">Scope</p>
            <h2>Work account in this repo. Personal in that one. OpenRouter in the next terminal.</h2>
            <p>Most switchers flip one global setting, and every open session flips with it. AnyPick lets you choose how far a change reaches.</p>
          </div>
          <div class="mt-10 grid gap-4 lg:grid-cols-3">
            {scopes.map((s) => (
              <article class="proof-card">
                <h3>{s.label}</h3>
                <pre class="cmd"><code>{s.command}</code></pre>
                <p>{s.body}</p>
                {s.href && <a href={s.href}>Project bindings <Icon name="ph:arrow-right" class="h-4 w-4" /></a>}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section-shell">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="section-heading max-w-3xl">
            <p class="section-kicker">Works with what you already use</p>
            <h2>11 coding agents. 32 sources. One picker.</h2>
          </div>
          <div class="mt-10 grid gap-8 lg:grid-cols-3">
            <div>
              <h3 class="list-title">Coding agents</h3>
              <ul class="chip-list">{agents.map((a) => <li>{a}</li>)}</ul>
            </div>
            <div>
              <h3 class="list-title">Sign in, or reuse the login you already have</h3>
              <ul class="chip-list">{logins.map((a) => <li>{a}</li>)}</ul>
            </div>
            <div>
              <h3 class="list-title">Bring an API key</h3>
              <ul class="chip-list">{apiKeys.map((a) => <li>{a}</li>)}<li>and more</li></ul>
            </div>
          </div>
          <p class="boundary-note mt-8">Not every pairing makes sense, and AnyPick only offers the ones that work. <strong>Claude logins power Claude Code only.</strong> The Gemini CLI and Kiro apps only switch between their own provider's accounts. <a class="text-link" href="/docs/reference/cli">CLI reference</a></p>
        </div>
      </section>

      <section class="section-shell border-y border-white/8 bg-[#0B0D15]">
        <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[1fr_1fr] lg:items-start">
          <div>
            <div class="section-heading">
              <p class="section-kicker">Safe by default</p>
              <h2>It won't clobber your config. And it can always put it back.</h2>
            </div>
            <div class="mt-8 space-y-6">
              {safety.map((s) => (
                <div class="benefit-row">
                  <span><Icon name={s.icon} class="h-5 w-5" /></span>
                  <div><h3>{s.title}</h3><p>{s.body}</p></div>
                </div>
              ))}
            </div>
            <p class="note mt-6">In the desktop app, every change is shown as a plan you approve before anything is written.</p>
          </div>
          <div class="diff-stack" aria-label="settings.json before, after use, and after reset (real output from the demo recording; token redacted)">
            <div class="plan-panel">
              <div class="diff-head"><p>~/.claude/settings.json · before</p></div>
              <pre class="diff"><code>{`{"theme":"dark"}`}</code></pre>
            </div>
            <div class="plan-panel">
              <div class="diff-head"><p>after <code>anypick use claude --with openrouter-work</code></p></div>
              <pre class="diff"><code><span class="add">{`+ "_anypickManaged": { "keys": ["ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "ANTHROPIC_API_KEY"] },
+ "env": {
+   "ANTHROPIC_AUTH_TOKEN": "<redacted>",
+   "ANTHROPIC_BASE_URL": "https://openrouter.ai/api"
+ },`}</span>{`
  "theme": "dark"`}</code></pre>
            </div>
            <div class="plan-panel">
              <div class="diff-head"><p>after <code>anypick reset claude --yes</code></p></div>
              <pre class="diff"><code>{`{"theme":"dark"}`}</code></pre>
            </div>
          </div>
        </div>
      </section>

      <section class="section-shell">
        <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="section-heading">
            <p class="section-kicker">Different protocols? Handled.</p>
            <h2>Codex on OpenRouter. Claude Code on Kimi. No glue scripts.</h2>
            <p>Coding agents speak different APIs: Anthropic Messages, OpenAI Responses. When the agent and the provider don't match, AnyPick starts a small translator on your machine (loopback only) and points the agent at it. AnyPick's core starts and owns the translator.</p>
            <p class="note mt-4">When a translator is used, the agent's config gets a local, per-proxy token, not your provider key. No server to run, no YAML, no <code>ANTHROPIC_API_KEY=""</code> tricks to remember.</p>
          </div>
          <pre class="code-block"><code><span class="c"># see what this connection can serve</span>
anypick add gateway openrouter-work --provider openrouter --api-key "$OPENROUTER_API_KEY"
anypick models codex --with openrouter-work
anypick use codex --with openrouter-work

<span class="c"># Claude Code via a local translator</span>
anypick add account kimi --name main --api-key "$MOONSHOT_API_KEY"
anypick use claude --with kimi/main --model &lt;kimi-model-id&gt;</code></pre>
        </div>
      </section>

      <section class="section-shell border-y border-white/8 bg-[#0B0D15]">
        <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="section-heading">
            <p class="section-kicker">Your first 60 seconds</p>
            <h2>From install to coding in three commands.</h2>
            <p>Then: <code>anypick list accounts</code> · <code>anypick tui</code> (an interactive picker) · <code>anypick doctor</code></p>
            <a class="primary-cta mt-6" href={gettingStartedUrl}>Read the 5-minute guide <Icon name="ph:arrow-right" class="h-4 w-4" /></a>
          </div>
          <pre class="code-block"><code>brew install outof0/tap/anypick                    <span class="c"># or: npm i -g anypick</span>
anypick add account claude --current --name work   <span class="c"># save the login you're signed in to</span>
anypick use claude --with claude/work              <span class="c"># pick it</span></code></pre>
        </div>
      </section>


      <section class="section-shell border-y border-white/8 bg-[#0B0D15]">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="section-heading max-w-3xl">
            <p class="section-kicker">Why you can trust it with your keys</p>
