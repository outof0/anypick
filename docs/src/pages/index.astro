---
import { Icon } from "astro-icon/components";
import { config } from "virtual:nimbus/config";
import Downloads from "../components/Downloads.astro";
import AppShot from "../components/AppShot.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/landing.css";
import { getTranslator, localizedPath, type Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = await getTranslator(locale);

const githubUrl = config.github ?? "https://github.com/outof0/anypick";
const releasesUrl = `${githubUrl}/releases/latest`;
const gettingStartedUrl = localizedPath(locale, "/docs/getting-started/");
const projectsGuideUrl = localizedPath(locale, "/docs/guides/projects/");
const compatibilityUrl = localizedPath(locale, "/docs/reference/cli/");
const homeUrl = localizedPath(locale, "/");
const docsUrl = localizedPath(locale, "/docs/");
const npmCommand = "npm install -g anypick";
const title = t("landing.meta.title");
const description = t("landing.meta.description");

const routes = [
  { label: t("landing.workflow.routeDefault"), command: "anypick use claude --with claude/work" },
  { label: t("landing.workflow.routeProject"), command: "anypick link claude --with claude/personal" },
  { label: t("landing.workflow.routeSession"), command: "anypick run claude --with openrouter-work" },
];

const clients = [
  "Claude Code", "OpenAI Codex", "Gemini CLI", "OpenCode", "Kiro", "Pi",
  "Omp", "Command Code", "DeepSeek Harness", "WorkBuddy AI", "ZCode",
];

const safetySteps = [
  {
    title: t("landing.safety.reviewTitle"),
    body: t("landing.safety.reviewBody"),
  },
  {
    title: t("landing.safety.configTitle"),
    body: t("landing.safety.configBody"),
  },
  {
    title: t("landing.safety.restoreTitle"),
    body: t("landing.safety.restoreBody"),
  },
];

const faqs = [
  {
    q: t("landing.faq.freeQ"),
    a: t("landing.faq.freeA"),
  },
  {
    q: t("landing.faq.accountsQ"),
    ...(() => {
      const marker = "___COMPATIBILITY_LINK___";
      const answer = t("landing.faq.accountsA", { accountsALink: marker });
      const [before = answer, ...after] = answer.split(marker);
      return {
        aBefore: before,
        aAfter: after.join(marker),
        link: t("landing.faq.accountsALink"),
      };
    })(),
  },
  {
    q: t("landing.faq.relayQ"),
    a: t("landing.faq.relayA"),
  },
  {
    q: t("landing.faq.credentialsQ"),
    a: t("landing.faq.credentialsA"),
  },
  {
    q: t("landing.faq.macQ"),
    a: t("landing.faq.macA"),
  },
];
---

<BaseLayout
  title={title}
  socialTitle={title}
  description={description}
  socialImage="/og-landing.png"
  socialImageAlt={t("landing.meta.socialAlt")}
>
  <div
    class="landing"
    lang={locale}
    data-copy-label={t("landing.install.copy")}
    data-copied-label={t("landing.install.copied")}
    data-copy-message={t("landing.install.copyStatus")}
    data-copy-failed={t("landing.install.copyFailed")}
  >
    <Header showSidebar={false} appearance="landing" locale={locale} />

    <main id="main-content">
      <section class="landing-hero">
        <div class="landing-wrap landing-hero-inner">
          <div class="landing-hero-copy">
            <p class="landing-eyebrow">{t("landing.hero.eyebrow")}</p>
            <h1>{t("landing.hero.titleStart")}<br /><em>{t("landing.hero.titleEnd")}</em></h1>
            <p class="landing-lede">{t("landing.hero.lede")}</p>
            <div class="landing-actions">
              <a class="landing-button landing-button-primary" href="#download" data-download-cta>
                <span data-download-label>{t("landing.hero.primary")}</span> <Icon name="ph:arrow-down" class="h-4 w-4" aria-hidden="true" />
              </a>
              <a class="landing-button landing-button-secondary" href="#how-it-works">
                {t("landing.hero.secondary")} <Icon name="ph:arrow-down" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
            <p class="landing-other-platforms"><a href="#download">{t("downloads.allPlatforms")}</a></p>
            <p class="landing-meta">
              <span>{t("landing.hero.platforms")}</span>
              <span>{t("landing.hero.openSource")}</span>
              <span>{t("landing.hero.noCloud")}</span>
            </p>
          </div>

          <div class="landing-product-stage">
            <figure class="landing-product-window">
              <AppShot
                name="overview"
                width={1040}
                height={760}
                sizes="(min-width: 1100px) 690px, (min-width: 832px) 52vw, calc(100vw - 3rem)"
                priority
                alt={t("landing.hero.overviewAlt")}
              />
            </figure>
            <figure class="landing-tray-window">
              <AppShot
                name="tray"
                width={336}
                height={430}
                sizes="(min-width: 832px) 215px, 155px"
                alt={t("landing.hero.trayAlt")}
              />
            </figure>
            <p class="landing-product-caption">{t("landing.hero.caption")}</p>
          </div>
        </div>
      </section>

      <section class="landing-proof" aria-label={t("landing.proof.aria")}>
        <div class="landing-wrap landing-proof-inner">
          <div class="landing-proof-item">
            <strong>{t("landing.proof.clientsTitle")}</strong>
            <span>{t("landing.proof.clientsBody")}</span>
          </div>
          <div class="landing-proof-item">
            <strong>{t("landing.proof.localTitle")}</strong>
            <span>{t("landing.proof.localBody")}</span>
          </div>
          <div class="landing-proof-item">
            <strong>{t("landing.proof.licenseTitle")}</strong>
            <span>{t("landing.proof.licenseBody")}</span>
          </div>
        </div>
      </section>

      <Downloads locale={locale} />

      <section class="landing-section" id="how-it-works">
        <div class="landing-wrap landing-route-grid">
          <div>
            <p class="landing-kicker">{t("landing.workflow.kicker")}</p>
            <h2>{t("landing.workflow.title")}</h2>
            <p class="landing-section-lede">{t("landing.workflow.body")}</p>
            <p class="landing-route-note">
              <a class="landing-inline-link" href={projectsGuideUrl}>{t("landing.workflow.projectLink")} <Icon name="ph:arrow-right" class="inline h-3.5 w-3.5" aria-hidden="true" /></a>
            </p>
          </div>
          <div class="landing-route-list" aria-label={t("landing.workflow.routesLabel")}>
            {routes.map((route) => (
              <div class="landing-route-row">
                <h3>{route.label}</h3>
                <code>{route.command}</code>
              </div>
            ))}
          </div>

          <ol class="landing-start-steps" aria-label={t("landing.workflow.stepsLabel")}>
            <li><span aria-hidden="true">01</span><div><h3>{t("landing.workflow.saveTitle")}</h3><p>{t("landing.workflow.saveBody")}</p></div></li>
            <li><span aria-hidden="true">02</span><div><h3>{t("landing.workflow.toolTitle")}</h3><p>{t("landing.workflow.toolBody")}</p></div></li>
            <li><span aria-hidden="true">03</span><div><h3>{t("landing.workflow.applyTitle")}</h3><p>{t("landing.workflow.applyBody")}</p></div></li>
          </ol>
        </div>
      </section>

      <section class="landing-section landing-safety-section">
        <div class="landing-wrap landing-safety-grid">
          <div>
            <p class="landing-kicker">{t("landing.safety.kicker")}</p>
            <h2>{t("landing.safety.title")}</h2>
            <div class="landing-safety-list">
              {safetySteps.map((step, index) => (
                <article class="landing-safety-item">
                  <span>0{index + 1}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <figure class="landing-account-shot">
            <AppShot
              name="accounts"
              width={1040}
              height={760}
              sizes="(min-width: 832px) 590px, calc(100vw - 3rem)"
              alt={t("landing.safety.accountAlt")}
            />
          </figure>
        </div>
      </section>

      <section class="landing-section landing-compatibility">
        <div class="landing-wrap landing-compatibility-grid">
          <div>
            <p class="landing-kicker">{t("landing.compatibility.kicker")}</p>
            <h2>{t("landing.compatibility.title")}</h2>
          </div>
          <div>
            <p class="landing-section-lede">{t("landing.compatibility.body")}</p>
            <div class="landing-client-list" aria-label={t("landing.compatibility.clients")}>
              {clients.map((client) => <span>{client}</span>)}
            </div>
            <p class="landing-boundary">
              <strong>{t("landing.compatibility.claudeRule")}</strong> {t("landing.compatibility.otherRule")} <a class="landing-inline-link" href={compatibilityUrl}>{t("landing.compatibility.reference")}</a>.
            </p>
          </div>
        </div>
      </section>

      <section class="landing-section landing-safety-section" id="install">
        <div class="landing-wrap landing-cli-grid">
          <div>
            <div class="landing-install-intro">
              <p class="landing-kicker">{t("landing.install.kicker")}</p>
              <h2>{t("landing.install.title")}</h2>
              <p class="landing-section-lede">{t("landing.install.body")}</p>
            </div>
            <figure class="landing-demo-frame landing-cli-demo">
              <div class="landing-demo-titlebar" aria-hidden="true">
                <span></span><span></span><span></span>
                <p>{t("landing.install.demoTitle")}</p>
              </div>
              <video
                class="landing-demo-video"
                controls
                muted
                loop
                playsinline
                preload="none"
                width="1280"
                height="720"
                poster="/demo/anypick-hero-poster.png"
                aria-label={t("landing.install.videoAlt")}
                data-demo-video
              >
                <source src="/demo/anypick-hero.webm" type="video/webm" />
                <source src="/demo/anypick-hero.mp4" type="video/mp4" />
                <img src="/demo/anypick-hero.gif" alt="AnyPick CLI demo" width="1280" height="720" />
              </video>
              <figcaption>{t("landing.install.demoCaption")}</figcaption>
            </figure>
          </div>

          <div class="landing-install-card" data-install-tabs>
            <h3 class="landing-install-heading">{t("landing.install.cli")}</h3>
            <div class="landing-install-tabs" role="tablist" aria-label={t("landing.install.method")}>
              <button id="install-tab-macos" class="landing-install-tab" type="button" role="tab" aria-selected="true" aria-controls="install-panel-macos" data-install-tab="macos">macOS</button>
              <button id="install-tab-linux" class="landing-install-tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-linux" tabindex="-1" data-install-tab="linux">Linux</button>
              <button id="install-tab-windows" class="landing-install-tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-windows" tabindex="-1" data-install-tab="windows">Windows</button>
              <button id="install-tab-npm" class="landing-install-tab" type="button" role="tab" aria-selected="false" aria-controls="install-panel-npm" tabindex="-1" data-install-tab="npm">npm</button>
            </div>

            <div class="landing-install-panel" id="install-panel-macos" role="tabpanel" aria-labelledby="install-tab-macos" data-install-panel="macos">
              <div class="landing-install-command">
                <span class="prompt" aria-hidden="true">$</span>
                <code>brew install outof0/tap/anypick</code>
                <button type="button" data-copy="brew install outof0/tap/anypick" aria-label={t("landing.install.copyCommand", { name: "Homebrew" })}><Icon name="ph:copy" class="h-4 w-4" aria-hidden="true" /><span>{t("landing.install.copy")}</span></button>
              </div>
              <p class="landing-install-hint">{t("landing.install.brewBefore")}<a href={releasesUrl}>{t("landing.install.brewLink")}</a>{t("landing.install.brewAfter")}</p>
            </div>

            <div class="landing-install-panel" id="install-panel-linux" role="tabpanel" aria-labelledby="install-tab-linux" data-install-panel="linux" hidden>
              <div class="landing-install-command">
                <span class="prompt" aria-hidden="true">$</span>
                <code>{npmCommand}</code>
                <button type="button" data-copy={npmCommand} aria-label={t("landing.install.copyCommand", { name: "npm" })}><Icon name="ph:copy" class="h-4 w-4" aria-hidden="true" /><span>{t("landing.install.copy")}</span></button>
              </div>
              <p class="landing-install-hint">{t("landing.install.linuxBefore")}<a href={releasesUrl}>{t("landing.install.linuxLink")}</a>{t("landing.install.linuxAfter")}</p>
            </div>

            <div class="landing-install-panel" id="install-panel-windows" role="tabpanel" aria-labelledby="install-tab-windows" data-install-panel="windows" hidden>
              <div class="landing-install-command">
                <span class="prompt" aria-hidden="true">&gt;</span>
                <code>scoop bucket add outof0 https://github.com/outof0/scoop-bucket</code>
                <button type="button" data-copy="scoop bucket add outof0 https://github.com/outof0/scoop-bucket" aria-label={t("landing.install.copyCommand", { name: "Scoop" })}><Icon name="ph:copy" class="h-4 w-4" aria-hidden="true" /><span>{t("landing.install.copy")}</span></button>
              </div>
              <div class="landing-install-command landing-install-command-secondary">
                <span class="prompt" aria-hidden="true">&gt;</span>
                <code>scoop install anypick</code>
                <button type="button" data-copy="scoop install anypick" aria-label={t("landing.install.copyCommand", { name: "Scoop" })}><Icon name="ph:copy" class="h-4 w-4" aria-hidden="true" /><span>{t("landing.install.copy")}</span></button>
              </div>
              <p class="landing-install-hint">{t("landing.install.windowsBefore")}<a href={releasesUrl}>{t("landing.install.windowsLink")}</a>{t("landing.install.windowsAfter")}</p>
            </div>

            <div class="landing-install-panel" id="install-panel-npm" role="tabpanel" aria-labelledby="install-tab-npm" data-install-panel="npm" hidden>
              <div class="landing-install-command">
                <span class="prompt" aria-hidden="true">$</span>
                <code>{npmCommand}</code>
                <button type="button" data-copy={npmCommand} aria-label={t("landing.install.copyCommand", { name: "npm" })}><Icon name="ph:copy" class="h-4 w-4" aria-hidden="true" /><span>{t("landing.install.copy")}</span></button>
              </div>
              <p class="landing-install-hint">{t("landing.install.npmHint")}</p>
            </div>
            <p class="landing-first-run">{t("landing.install.firstRun")} <code>anypick tui</code> {t("landing.install.picker")}</p>
            <a class="landing-release-link" href={gettingStartedUrl}>{t("landing.install.guide")} <Icon name="ph:arrow-right" class="h-3.5 w-3.5" aria-hidden="true" /></a>
            <p class="sr-only" aria-live="polite" data-copy-status></p>
          </div>
        </div>
      </section>

      <section class="landing-section">
        <div class="landing-wrap landing-faq-inner">
          <p class="landing-kicker">{t("landing.faq.kicker")}</p>
          <h2>{t("landing.faq.title")}</h2>
          <div class="landing-faq">
            {faqs.map((faq) => (
              <details>
                <summary>{faq.q}</summary>
                {"a" in faq ? (
                  <p>{faq.a}</p>
                ) : (
                  <p>{faq.aBefore}<a href={compatibilityUrl}>{faq.link}</a>{faq.aAfter}</p>
                )}
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="landing-section landing-final">
        <div class="landing-wrap landing-final-inner">
          <p class="landing-kicker">{t("landing.final.kicker")}</p>
          <h2>{t("landing.final.titleStart")}<br />{t("landing.final.titleEnd")}</h2>
          <p class="landing-section-lede">{t("landing.final.body")}</p>
          <div class="landing-actions">
            <a class="landing-button landing-button-primary" href="#download" data-download-cta><span data-download-label>{t("landing.final.cta")}</span> <Icon name="ph:arrow-down" class="h-4 w-4" aria-hidden="true" /></a>
            <a class="landing-inline-link" href={gettingStartedUrl}>{t("landing.final.guide")}</a>
          </div>
          <p class="landing-meta">{t("landing.final.meta")}</p>
        </div>
      </section>
    </main>

    <footer class="landing-footer">
      <div class="landing-wrap flex flex-col items-center justify-between gap-4 py-7 sm:flex-row">
        <a href={homeUrl} aria-label={t("landing.footer.home")}><img src="/logo-dark.svg" alt="AnyPick" width="98" height="20" /></a>
        <nav aria-label={t("landing.footer.navigation")} class="flex flex-wrap justify-center gap-x-5 gap-y-2">
          <a href={docsUrl}>{t("landing.footer.docs")}</a>
          <a href={githubUrl} target="_blank" rel="noopener">GitHub</a>
          <a href={`${githubUrl}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">{t("landing.footer.changelog")}</a>
          <a href={`${githubUrl}/blob/main/SECURITY.md`} target="_blank" rel="noopener">{t("landing.footer.security")}</a>
          <a href={`${githubUrl}/blob/main/LICENSE`} target="_blank" rel="noopener">{t("landing.footer.license")}</a>
        </nav>
        <span>© OutOf0</span>
      </div>
    </footer>
  </div>

  <script>
    const installRoot = document.querySelector<HTMLElement>("[data-install-tabs]");
    const tabs = Array.from(installRoot?.querySelectorAll<HTMLButtonElement>("[data-install-tab]") ?? []);
    const panels = Array.from(installRoot?.querySelectorAll<HTMLElement>("[data-install-panel]") ?? []);

    const activateTab = (name: string, focus = false) => {
      for (const tab of tabs) {
        const selected = tab.dataset.installTab === name;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      }
      for (const panel of panels) panel.hidden = panel.dataset.installPanel !== name;
    };

    const platform = navigator.userAgent.toLowerCase();
    if (platform.includes("windows")) activateTab("windows");
    else if (platform.includes("linux") && !platform.includes("android")) activateTab("linux");

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener("click", () => activateTab(tab.dataset.installTab ?? "macos"));
      tab.addEventListener("keydown", (event) => {
        const next = event.key === "ArrowRight" || event.key === "ArrowDown"
          ? (index + 1) % tabs.length
          : event.key === "ArrowLeft" || event.key === "ArrowUp"
            ? (index + tabs.length - 1) % tabs.length
            : event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : -1;
        if (next >= 0) {
          event.preventDefault();
          activateTab(tabs[next]?.dataset.installTab ?? "macos", true);
        }
      });
    }

    const revealSections = () => {
      const sections = Array.from(document.querySelectorAll<HTMLElement>(".landing-section"));
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reducedMotion || !("IntersectionObserver" in window)) {
        sections.forEach((section) => section.classList.add("landing-visible"));
        return;
      }

      document.documentElement.dataset.landingMotion = "ready";
      const observer = new IntersectionObserver((entries, activeObserver) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("landing-visible");
          activeObserver.unobserve(entry.target);
        }
      }, { threshold: 0.08, rootMargin: "0px 0px -5% 0px" });

      for (const section of sections) {
        if (section.getBoundingClientRect().top < window.innerHeight * 0.88) {
          section.classList.add("landing-visible");
        } else {
          observer.observe(section);
        }
      }
    };

    revealSections();

    const landing = document.querySelector<HTMLElement>(".landing");
    const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        const command = button.dataset.copy;
        if (!command) return;
        try {
          await navigator.clipboard.writeText(command);
          button.querySelector("span")!.textContent = landing?.dataset.copiedLabel ?? "";
          if (copyStatus) copyStatus.textContent = landing?.dataset.copyMessage ?? "";
          window.setTimeout(() => {
            const label = button.querySelector("span");
            if (label) label.textContent = landing?.dataset.copyLabel ?? "";
          }, 1600);
        } catch {
          if (copyStatus) copyStatus.textContent = landing?.dataset.copyFailed ?? "";
        }
      });
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelector<HTMLVideoElement>("[data-demo-video]")?.pause();
    }
  </script>
</BaseLayout>
