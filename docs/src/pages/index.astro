  <script>
    const status = document.querySelector("[data-copy-status]");
    const installTabs = document.querySelector<HTMLElement>("[data-install-tabs]");
    const tabs = Array.from(installTabs?.querySelectorAll<HTMLButtonElement>("[data-install-tab]") ?? []);
    const panels = Array.from(installTabs?.querySelectorAll<HTMLElement>("[data-install-panel]") ?? []);

    const activateTab = (name: string, focus = false) => {
      for (const tab of tabs) {
        const selected = tab.dataset.installTab === name;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      }
      for (const panel of panels) panel.hidden = panel.dataset.installPanel !== name;
    };

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener("click", () => activateTab(tab.dataset.installTab ?? "macos"));
      tab.addEventListener("keydown", (event) => {
        const next = event.key === "ArrowRight" || event.key === "ArrowDown"
          ? (index + 1) % tabs.length
          : event.key === "ArrowLeft" || event.key === "ArrowUp"
            ? (index + tabs.length - 1) % tabs.length
            : event.key === "Home"
              ? 0
              : event.key === "End"
                ? tabs.length - 1
                : -1;
        if (next < 0) return;
        event.preventDefault();
        activateTab(tabs[next].dataset.installTab ?? "macos", true);
      });
    }

    const userAgent = navigator.userAgent.toLowerCase();
    const detectedOS = /macintosh|mac os x|iphone|ipad/.test(userAgent)
      ? "macos"
      : /windows/.test(userAgent)
        ? "windows"
        : /linux|x11/.test(userAgent)
          ? "linux"
          : null;
    if (detectedOS) activateTab(detectedOS);

    // Respect reduced motion: keep the poster frame and let the user press play.
    const demo = document.querySelector<HTMLVideoElement>("[data-demo-video]");
    if (demo && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      demo.removeAttribute("autoplay");
      demo.pause();
      demo.controls = true;
    }

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copy;
        if (!value) return;
        const label = button.querySelector("span");
        const originalLabel = button.getAttribute("aria-label") ?? "Copy command";
        try {
          await navigator.clipboard.writeText(value);
          button.querySelector(".copy-icon")?.classList.add("hidden");
          button.querySelector(".check-icon")?.classList.remove("hidden");
          if (label) label.textContent = "Copied";
          button.setAttribute("aria-label", "Copied install command");
          if (status) status.textContent = "Install command copied";
          window.setTimeout(() => {
            button.querySelector(".copy-icon")?.classList.remove("hidden");
            button.querySelector(".check-icon")?.classList.add("hidden");
            if (label) label.textContent = "Copy";
            button.setAttribute("aria-label", originalLabel);
          }, 1800);
        } catch {
          if (status) status.textContent = "Could not copy install command";
        }
      });
    });
  </script>
