---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/globals.css";
import "../styles/prose.css";
import { config } from "virtual:nimbus/config";
import { getCollectionLlmsUrl, getVersionStatus } from "nimbus-docs";
import AgentDirective from "@/components/AgentDirective.astro";
import { SearchDialog } from "@/components/ui/search";
import NimbusHead from "nimbus-docs/components/NimbusHead.astro";
import release from "../data/release.json";
import type { BasePageProps } from "nimbus-docs/types";
import { getTranslator, localeForPath, localePrefix, supportedLocales } from "@/i18n";
import { localeAlternates as localeAlternatesFor } from "@/lib/seo";

type Props = BasePageProps & {
  /** Exact title that opts into the site's custom metadata head. */
  socialTitle?: string;
  /** Language tag used by Pagefind for this page's content. */
  pagefindLanguage?: string;
  /** Alt text for this page's social image; defaults to the site-wide alt. */
  socialImageAlt?: string;
};

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  lastUpdated,
  head: pageHead = [],
  collection,
  entryId,
  socialTitle,
  pagefindLanguage,
  socialImageAlt = config.socialImageAlt,
} = Astro.props;

const lang = localeForPath(Astro.url.pathname);
const t = await getTranslator(lang);
const socialLocales = { en: "en_US", "zh-CN": "zh_CN", vi: "vi_VN", de: "de_DE", es: "es_ES", fr: "fr_FR", ja: "ja_JP", ko: "ko_KR", "pt-BR": "pt_BR" };
// Point translated pages at their locale's index; English pages keep Nimbus'
// collection/version routing.
// Hidden-version pages don't advertise an agent index (the per-version
// llms.txt isn't emitted for them); suppress the AgentDirective entirely.
const versionStatus = collection ? await getVersionStatus(collection) : null;
const isHiddenVersion = versionStatus?.isHidden === true;
const llmsIndexPath = lang === "en"
  ? collection ? await getCollectionLlmsUrl(collection) : "/llms.txt"
  : `${localePrefix(lang)}/llms.txt`;
const llmsUrl = Astro.site
  ? new URL(llmsIndexPath, Astro.site).href
  : llmsIndexPath;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const socialImageUrl = socialImage
  ? Astro.site
    ? new URL(socialImage, Astro.site).href
    : socialImage
  : null;
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHomePage = normalizedPath === "/" || normalizedPath === localePrefix(lang);
const socialStructuredData = socialTitle && canonicalUrl
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": isHomePage ? "WebSite" : "WebPage",
      name: isHomePage ? config.title : socialTitle,
      ...(description ? { description } : {}),
      url: canonicalUrl,
      inLanguage: lang,
      ...(socialImageUrl ? { image: socialImageUrl } : {}),
      ...(!isHomePage
        ? {
            isPartOf: {
              "@type": "WebSite",
              name: config.title,
              url: Astro.site ? new URL("/", Astro.site).href : config.site,
            },
            ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
          }
        : {}),
    })
  : null;
const softwareApplicationStructuredData = isHomePage && canonicalUrl
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "AnyPick",
      applicationCategory: "DeveloperApplication",
      url: canonicalUrl,
      ...(description ? { description } : {}),
      softwareVersion: release.version.replace(/^v/, ""),
      downloadUrl: `${canonicalUrl}#download`,
      releaseNotes: release.url,
      ...(socialImageUrl ? { image: socialImageUrl } : {}),
      operatingSystem: ["macOS", "Linux", "Windows"],
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      license: "https://github.com/outof0/anypick/blob/main/LICENSE",
    })
  : null;
const localeAlternates = Astro.site && !noindex ? localeAlternatesFor(Astro.url.pathname, Astro.site) : [];
const mergedHead = [...(config.head ?? []), ...pageHead];
// NimbusHead renders no language alternates of its own, so docs pages carry
// theirs through its `head` passthrough.
const docsHead = [
  ...pageHead,
  ...localeAlternates.map(({ hreflang, href }) => ({ tag: "link" as const, attrs: { rel: "alternate", hreflang, href } })),
];
const shikiCssHref = `${import.meta.env.BASE_URL}_nimbus/shiki.css${import.meta.env.DEV ? `?v=${Date.now()}` : ""}`;
---

<!doctype html>
<html lang={lang} data-pagefind-language={pagefindLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      (() => {
        const KEY = "ui-mode";
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const readPref = () => {
          try {
            const v = localStorage.getItem(KEY);
            return v === "dark" || v === "light" ? v : null;
          } catch {
            return null;
          }
        };

        const resolveMode = () => readPref() ?? (media.matches ? "dark" : "light");

        const applyTheme = () => {
          const root = document.documentElement;
          const mode = resolveMode();
          if (mode === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          root.style.colorScheme = mode;
          document.querySelectorAll("[data-nb-theme-toggle]").forEach((b) => {
            b.setAttribute("data-nb-state", mode);
          });
        };

        applyTheme();
        media.addEventListener("change", () => {
          if (!readPref()) applyTheme();
        });
        window.addEventListener("storage", (e) => {
          if (e.key === KEY) applyTheme();
        });

        window.__nbApplyTheme = applyTheme;
      })();
    </script>

    {socialTitle ? (
      <>
        <title>{socialTitle}</title>
        <meta name="generator" content={Astro.generator} />
        {description && <meta name="description" content={description} />}
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="stylesheet" href={shikiCssHref} />
        {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
        {Astro.site && <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />}
        {isHomePage && <meta name="theme-color" content="#09090c" />}
        {localeAlternates.map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))}
        {markdownUrl && !isHiddenVersion && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
        {Astro.site && !isHiddenVersion && (
          <link rel="alternate" type="text/plain" href={llmsUrl} title="LLM index" />
        )}
        <meta property="og:title" content={socialTitle} />
        <meta property="og:type" content={isHomePage ? "website" : "article"} />
        <meta property="og:site_name" content={config.title} />
        <meta property="og:locale" content={socialLocales[lang]} />
        {isHomePage && supportedLocales.filter((locale) => locale !== lang).map((locale) => (
          <meta property="og:locale:alternate" content={socialLocales[locale]} />
        ))}
        {description && <meta property="og:description" content={description} />}
        {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
        {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
        {socialImageUrl && socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
        {socialImageUrl && <meta property="og:image:width" content="1200" />}
        {socialImageUrl && <meta property="og:image:height" content="630" />}
        {!isHomePage && lastUpdated && <meta property="article:modified_time" content={lastUpdated.toISOString()} />}
        <meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={socialTitle} />
        {description && <meta name="twitter:description" content={description} />}
        {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
        {socialImageUrl && socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
        {socialStructuredData && <script is:inline type="application/ld+json" set:html={socialStructuredData.replace(/</g, "\\u003c")} />}
        {softwareApplicationStructuredData && <script is:inline type="application/ld+json" set:html={softwareApplicationStructuredData.replace(/</g, "\\u003c")} />}
        {mergedHead.map(({ tag: Tag, attrs = {}, content }) =>
          content ? <Tag {...attrs} set:html={content} /> : <Tag {...attrs} />
        )}
      </>
    ) : (
      <NimbusHead
        title={title}
        description={description}
        noindex={noindex}
        markdownUrl={markdownUrl}
        socialImage={socialImage}
        lastUpdated={lastUpdated}
        head={docsHead}
        collection={collection}
        entryId={entryId}
      />
    )}
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground focus:no-underline focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2"
    >
      {t("common.skipToContent")}
    </a>
    {markdownUrl && !isHiddenVersion && <AgentDirective markdownUrl={markdownUrl} llmsUrl={llmsUrl} />}
    <slot />
    {config.search !== false && <SearchDialog />}

    <script>
      import { codeCopy, headingAnchors } from "nimbus-docs/client";
      codeCopy();
      headingAnchors();
    </script>
  </body>
</html>
