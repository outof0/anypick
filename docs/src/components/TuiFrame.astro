---
/**
 * A styled recreation of a real AnyPick TUI screen, for marketing and docs.
 *
 * The content mirrors what `anypick` actually prints (captured from the Ink
 * screens), and the colours mirror `src/tui/components/chrome/status.tsx`:
 * violet wordmark, info selection, and semantic status tokens.
 * It always renders dark, because it is a picture of a terminal rather than
 * part of the page surface.
 */

export interface TuiRow {
  name: string;
  detail?: string;
  status?: string;
  kind?: "live" | "saved" | "changed" | "failed" | "muted";
  selected?: boolean;
}

export type TuiBlock =
  | { group?: string; rows: TuiRow[] }
  | { group: string; note: string };

interface Props {
  /** Breadcrumb in the header, e.g. `switch`. */
  path: string;
  blocks: TuiBlock[];
  /** Bold line under the rule — what enter would do. */
  outcome: string;
  /** Dim line under the outcome. */
  support?: string;
  /** Footer key hints, in order. */
  hints: Array<[key: string, label: string]>;
  /** Width of the name column, in characters. */
  nameWidth?: string;
  class?: string;
}

const {
  path,
  blocks,
  outcome,
  support,
  hints,
  nameWidth = "11ch",
  class: className,
} = Astro.props;

// With no detail text to fill, a flexible middle column would strand the status
// token at the far right of a wide frame. Screens like the proxy board have no
// detail at all, so the status hugs the name instead.
const hasDetail = blocks.some(
  (block) => "rows" in block && block.rows.some((row) => row.detail),
);

const statusColor: Record<NonNullable<TuiRow["kind"]>, string> = {
  live: "text-[#A6FF4D]",
  saved: "text-[#F7F7FA]",
  changed: "text-[#F59E0B]",
  failed: "text-[#FF4D5A]",
  muted: "text-[#5A6478]",
};
---

<div
  class:list={[
    "overflow-hidden rounded-xl border border-white/10 bg-[#15151D] shadow-2xl",
    className,
  ]}
>
  <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
    <span class="h-2.5 w-2.5 rounded-full bg-[#FF4D5A]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#28C840]"></span>
    <span class="ml-2 font-mono text-[11px] text-[#5A6478]">anypick</span>
  </div>

  <div
    class="overflow-x-auto px-4 py-4 font-mono text-[13px] leading-[1.7] text-[#C7C7D0]"
  >
    <div class="min-w-[30rem]">
      <div>
        <span class="text-[#7357FF]">anypick</span>
        <span class="text-[#5A6478]">/</span>
        <span class="font-semibold text-[#F7F7FA]">{path}</span>
      </div>

      {
        blocks.map((block) => (
          <div class="mt-3">
            {block.group && (
              <div class="font-semibold text-[#F7F7FA]">{block.group}</div>
            )}
            {"note" in block ? (
              <div class="pl-[4ch] text-[#5A6478]">{block.note}</div>
            ) : (
              block.rows.map((row) => (
                <div class="flex items-baseline gap-3 pl-[3ch]">
                  <span
                    class="w-[2ch] shrink-0 font-semibold text-[#60A5FA]"
                    aria-hidden={!row.selected}
                  >
                    {row.selected ? "›" : ""}
                  </span>
                  <span
                    class:list={[
                      "shrink-0",
                      row.selected
                        ? "font-semibold text-[#60A5FA]"
                        : "text-[#C7C7D0]",
                    ]}
                    style={`width: ${nameWidth}`}
                  >
                    {row.name}
                  </span>
                  {hasDetail && (
                    <span class="flex-1 truncate text-[#8792A6]">{row.detail}</span>
                  )}
                  <span
                    class:list={[
                      "shrink-0 whitespace-nowrap",
                      statusColor[row.kind ?? "muted"],
                    ]}
                  >
                    {row.status}
                  </span>
                </div>
              ))
            )}
          </div>
        ))
      }

      <div class="mt-3 border-t border-dashed border-white/10 pt-2">
        <div class="font-semibold text-[#F7F7FA]">{outcome}</div>
        {support && <div class="text-[#5A6478]">{support}</div>}
      </div>

      <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
        {
          hints.map(([key, label]) => (
            <span class="whitespace-nowrap">
              <span class="font-semibold text-[#F7F7FA]">{key}</span>
              <span class="text-[#5A6478]"> {label}</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>
