{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyPick",
  "version": "1.2.1",
  "identifier": "dev.anypick.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AnyPick",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/anypick-core"],
    "icon": [
      "../../../assets/icon-32.png",
      "../../../assets/icon-128.png",
      "../../../assets/icon-256.png",
      "../../../assets/icon.ico"
    ]
  }
}
